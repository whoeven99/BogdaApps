// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

/// 薄账本：remaining = purchasePoints - usedPoints，对齐现有 Java 口径。
model Account {
  shop              String    @id
  plan              Int       @default(1)
  planType          String    @default("Free")
  feeType           Int       @default(0)
  purchasePoints    Int       @default(0)
  usedPoints        Int       @default(0)
  subscriptionGid   String?
  currentPeriodEnd  DateTime?
  hasUsedTrial      Boolean   @default(false)
  trialEndsAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  grants            CreditGrant[]
  usages            CreditUsage[]
}

/// Shopify 购包 / 订阅入账幂等。订阅续费用 periodKey 区分周期。
model CreditGrant {
  id         String   @id @default(cuid())
  shop       String
  gid        String
  periodKey  String
  kind       String
  credits    Int
  createdAt  DateTime @default(now())
  account    Account  @relation(fields: [shop], references: [shop], onDelete: Cascade)

  @@unique([gid, periodKey])
  @@index([shop])
}

model CreditUsage {
  id           String   @id @default(cuid())
  shop         String
  credits      Int
  source       String
  model        String?
  languageCode String?
  createdAt    DateTime @default(now())
  account      Account  @relation(fields: [shop], references: [shop], onDelete: Cascade)

  @@index([shop])
}

model UserPicture {
  id                   Int      @id @default(autoincrement())
  shop                 String
  imageId              String
  imageBeforeUrl       String
  imageAfterUrl        String?
  altBeforeTranslation String?
  altAfterTranslation  String?
  languageCode         String
  urlKey               String?
  imageAfterFileId     String?
  isDelete             Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([shop, imageId, imageBeforeUrl, languageCode])
  @@index([shop, imageId, languageCode, isDelete])
  @@index([shop, languageCode, urlKey])
}

model SwitcherImage {
  id             String   @id @default(cuid())
  shop           String
  urlKey         String
  imageBeforeUrl String
  lastPagePath   String?
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([shop, urlKey])
  @@index([shop, lastSeenAt])
}

model SwitcherImagePage {
  id         String   @id @default(cuid())
  shop       String
  urlKey     String
  pagePath   String
  targetCode String?
  lastSeenAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([shop, urlKey, pagePath, targetCode])
  @@index([shop, targetCode, pagePath, lastSeenAt])
  @@index([shop, lastSeenAt])
}
