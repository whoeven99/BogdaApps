// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

/// remaining = subscriptionCredits + purchasedCredits + trialCredits - usedCredits。
/// purchasePoints / usedPoints 为旧列兼容别名来源。
model Account {
  shop                    String    @id
  plan                    Int       @default(1)
  planType                String    @default("Free")
  feeType                 Int       @default(0)
  purchasePoints          Int       @default(0)
  usedPoints              Int       @default(0)
  subscriptionCredits     Int       @default(0)
  purchasedCredits        Int       @default(0)
  trialCredits            Int       @default(0)
  trialCreditsExpiresAt   DateTime?
  trialInstallCredits     Int       @default(0)
  trialInstallExpiresAt   DateTime?
  trialBonusCredits       Int       @default(0)
  trialBonusExpiresAt     DateTime?
  usedCredits             Int       @default(0)
  subscriptionGid         String?
  currentPeriodEnd        DateTime?
  hasUsedTrial            Boolean   @default(false)
  trialEndsAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  grants                  CreditGrant[]
  usages                  CreditUsage[]
  subscription            AppSubscription?
  billingLogs             BillingLog[]
}

/// Shopify 购包 / 订阅入账幂等。订阅续费用 periodKey 区分周期。
model CreditGrant {
  id         String   @id @default(cuid())
  shop       String
  gid        String
  periodKey  String
  kind       String
  credits    Int
  createdAt  DateTime @default(now())
  account    Account  @relation(fields: [shop], references: [shop], onDelete: Cascade)

  @@unique([gid, periodKey])
  @@index([shop])
}

model CreditUsage {
  id           String   @id @default(cuid())
  shop         String
  credits      Int
  source       String
  model        String?
  languageCode String?
  createdAt    DateTime @default(now())
  account      Account  @relation(fields: [shop], references: [shop], onDelete: Cascade)

  @@index([shop])
}

model UserPicture {
  id                   Int      @id @default(autoincrement())
  shop                 String
  imageId              String
  imageBeforeUrl       String
  imageAfterUrl        String?
  altBeforeTranslation String?
  altAfterTranslation  String?
  languageCode         String
  urlKey               String?
  imageAfterFileId     String?
  isDelete             Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([shop, imageId, imageBeforeUrl, languageCode])
  @@index([shop, imageId, languageCode, isDelete])
  @@index([shop, languageCode, urlKey])
}

model PlanCatalog {
  planKey         String   @id
  kind            String
  billingInterval String?
  displayName     String
  credits         Int
  priceAmount     String
  currencyCode    String   @default("USD")
  trialDays       Int?
  shopifyPlanName String?
  sortOrder       Int      @default(0)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([enabled, sortOrder])
}

model AppSubscription {
  shop                  String    @id
  planKey               String
  shopifySubscriptionId String    @unique
  billingInterval       String
  status                String
  creditsPerPeriod      Int
  trialEndsAt           DateTime?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  cancelledAt           DateTime?
  rawPayload            Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  account Account @relation(fields: [shop], references: [shop], onDelete: Cascade)

  @@index([status])
}

model BillingLog {
  id           String   @id @default(cuid())
  shop         String
  eventType    String
  planKey      String?
  referenceId  String?
  creditsDelta Int?
  usedCredits  Int?
  metadata     Json?
  createdAt    DateTime @default(now())

  account Account @relation(fields: [shop], references: [shop], onDelete: Cascade)

  @@index([shop, createdAt])
  @@index([eventType, createdAt])
  @@index([referenceId])
}

model BillingReconcileLock {
  id       String   @id
  lockedAt DateTime
}

model SwitcherImage {
  id             String   @id @default(cuid())
  shop           String
  urlKey         String
  imageBeforeUrl String
  lastPagePath   String?
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([shop, urlKey])
  @@index([shop, lastSeenAt])
}

model SwitcherImagePage {
  id         String   @id @default(cuid())
  shop       String
  urlKey     String
  pagePath   String
  targetCode String?
  lastSeenAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([shop, urlKey, pagePath, targetCode])
  @@index([shop, targetCode, pagePath, lastSeenAt])
  @@index([shop, lastSeenAt])
}

model ImageTranslateJob {
  id             String    @id
  shop           String
  targetLanguage String
  model          String
  /// content = 文章/主题/第三方；product = 商品相册
  kind           String    @default("content")
  /// QUEUED | RUNNING | PAUSED | COMPLETED | CANCELLED
  status         String
  /// MANUAL | QUOTA_INSUFFICIENT | SCOPE_MISSING | SERVICE_ERROR
  pauseReason    String?
  retranslate    Boolean   @default(false)
  total          Int       @default(0)
  done           Int       @default(0)
  failed         Int       @default(0)
  skipped        Int       @default(0)
  creditsUsed    Int       @default(0)
  claimedBy      String?
  heartbeatAt    DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([shop, createdAt])
  @@index([shop, kind, createdAt])
  @@index([status, updatedAt])
}

model ImageTranslateJobItem {
  id            String   @id
  jobId         String
  shop          String
  urlKey        String
  imageUrl      String
  /// 商品相册为 Product GID；content 为空串
  productId     String   @default("")
  resourceTitle String?
  /// PENDING | DONE | FAILED | SKIPPED
  status        String   @default("PENDING")
  error         String?
  imageAfterUrl String?
  credits       Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([jobId, urlKey, productId])
  @@index([jobId, status])
}
